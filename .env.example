# QR Portal Environment Configuration
# Copy this file to .env and update values for your environment

# Database Configuration
SQLITE_DB_PATH=./data/quality.sqlite

# Application Configuration
PORT=3000
NODE_ENV=development
PUBLIC_BASE_URL=http://localhost:3000

# Authentication Configuration
DISABLE_AUTH=false

AUTH_MODE=local
# Comma-separated list of admin emails allowed to access /admin
ADMIN_USERS=admin@example.com,manager@example.com
# Shared access code required along with email to login
LOCAL_ACCESS_CODE=change-me-to-a-long-random-string

# Session Configuration
SESSION_SECRET=change-me-to-a-long-random-string

# Note: Azure Storage variables are no longer needed
# All files are stored directly in the SQLite database