# QR Portal Environment Configuration
# Copy this file to .env and update values for your environment

# Database Configuration
SQLITE_DB_PATH=./data/quality.sqlite

# Application Configuration
PORT=3000
NODE_ENV=development
PUBLIC_BASE_URL=http://localhost:3000

# Authentication Configuration
DISABLE_AUTH=false

AUTH_MODE=local
# Comma-separated list of admin emails allowed to access /admin
ADMIN_USERS=admin@example.com,manager@example.com
# Shared access code required along with email to login
LOCAL_ACCESS_CODE=change-me-to-a-long-random-string

# Session Configuration
SESSION_SECRET=change-me-to-a-long-random-string

# ME-QR Configuration
# Obtain your API token from ME-QR enterprise and paste below
MEQR_API_TOKEN=
# Optional defaults (can be overridden per-request)
MEQR_QR_SIZE=1024
MEQR_QR_ECL=H
MEQR_QR_PATTERN_COLOR=#000000
MEQR_QR_BG_COLOR=#FFFFFF
MEQR_QR_CORNERS_OUTER_COLOR=#000000
MEQR_QR_CORNERS_INNER_COLOR=#000000
# Default logo URL used in the QR center (must be publicly accessible)
MEQR_QR_LOGO_URL=http://localhost:3000/logo.png
MEQR_QR_FRAME_NAME=noFrame
MEQR_QR_FRAME_COLOR=#000000
MEQR_QR_FRAME_BG_COLOR=#FFFFFF
MEQR_QR_DESIGN_TYPE=base

# Optional shape controls (depends on ME-QR supported values)
# Options often include: square | rounded | dots (verify in ME-QR)
MEQR_QR_PATTERN_SHAPE=square
MEQR_QR_CORNERS_OUTER_SHAPE=square
MEQR_QR_CORNERS_INNER_SHAPE=square

# Frames are only supported for base design per ME-QR docs
# Finalized helmet frame selection (index 124):
#   name = hundredTventyFive
# Set designType to base and use this frame to apply the helmet frame by default.
MEQR_QR_FRAME_NAME=hundredTventyFive

# Admin-only probe endpoints feature flag (disabled by default)
ENABLE_PROBE=false

# Note: Azure Storage variables are no longer needed
# All files are stored directly in the SQLite database