{
  "platform": {
    "enabled": true
  },
  "globalValidation": {
    "unauthenticatedClientAction": "RedirectToLoginPage",
    "excludedPaths": [
      "/",
      "/healthz",
      "/readyz",
      "/folders",
      "/folder/*",
      "/docs/*",
      "/debug/*",
      "/favicon.ico",
      "/logo.png",
      "/public/*"
    ]
  },
  "httpSettings": {
    "requireHttps": true
  },
  "login": {
    "tokenStore": {
      "enabled": true
    },
    "preserveUrlFragmentsForLogins": true,
    "allowedExternalRedirectUrls": []
  },
  "identityProviders": {
    "azureActiveDirectory": {
      "enabled": true,
      "registration": {
        "openIdIssuer": "https://login.microsoftonline.com/__TENANT_ID__/v2.0",
        "clientId": "__CLIENT_ID__",
        "clientSecretSettingName": "AAD_CLIENT_SECRET"
      },
      "login": {
        "loginParameters": [
          "response_type=code",
          "response_mode=query",
          "prompt=select_account"
        ]
      },
      "validation": {
        "allowedAudiences": [
          "api://__CLIENT_ID__",
          "__CLIENT_ID__"
        ]
      }
    }
  }
}
