# QR Portal Environment Configuration
# Copy this file to .env and update values for your environment

# Database Configuration
SQLITE_DB_PATH=./data/quality.sqlite

# Application Configuration
PORT=3000
NODE_ENV=development
PUBLIC_BASE_URL=http://localhost:3000

# Authentication Configuration (Production)
ADMIN_EMAILS=admin@example.com,manager@example.com
EASY_AUTH=false

# Note: Azure Storage variables are no longer needed
# All files are stored directly in the SQLite database